{
  "name": "ShopAI",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "expo start",
    "eas-build-post-install": "node scripts/prepare-eas-firebase-config.js",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit",
    "eas:build:preview": "npx eas-cli@latest build --platform android --profile preview",
    "eas:build:production": "npx eas-cli@latest build --platform android --profile production",
    "eas:update:staging": "node scripts/eas-update.js staging",
    "eas:update:production": "node scripts/eas-update.js production"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-updates"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-community/geolocation",
          "react-native-biometrics"
        ]
      }
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "expo": "~58.0.0",
    "expo-updates": "~58.0.17",
    "i18next": "^26.4.2",
    "lottie-react-native": "^7.5.0",
    "lucide-react-native": "^1.53.0",
    "react": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.88.0",
    "react-native-biometrics": "^3.0.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "^0.13.0",
    "react-redux": "^9.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^8.19.0",
    "jest": "~30.5.2",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
